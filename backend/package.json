{
    "name": "thai-transcriber-backend",
    "version": "2.0.0",
    "description": "Modular relay server for Thai Verbatim Transcriber",
    "main": "src/server.ts",
    "type": "module",
    "scripts": {
        "start": "NODE_OPTIONS='--no-deprecation' tsx src/server.ts",
        "dev": "NODE_OPTIONS='--no-deprecation' tsx watch src/server.ts",
        "start:legacy": "NODE_OPTIONS='--no-deprecation' tsx server.ts"
    },
    "dependencies": {
        "@deepgram/sdk": "^3.7.0",
        "@google/generative-ai": "^0.21.0",
        "cors": "^2.8.6",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/ws": "^8.5.10",
        "tsx": "^4.7.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
