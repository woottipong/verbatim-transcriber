# =============================================================================
# Thai Verbatim Transcriber - Backend Configuration
# =============================================================================
# 
# NOTE: Each ASR provider endpoint will only be enabled if its API key is set.
# You can leave unused providers empty - those endpoints won't be available.
#
# =============================================================================

# Deepgram API Configuration
# Leave empty to disable /deepgram endpoint
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Gemini API Configuration  
# Leave empty to disable /gemini endpoint
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Speech-to-Text API Configuration
# Leave empty to disable /google endpoint
GOOGLE_API_KEY=your_google_api_key_here
# Or use Application Default Credentials (ADC) by setting:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Speech Service Configuration
# Leave both empty to disable /azure endpoint
AZURE_SUBSCRIPTION_KEY=your_azure_subscription_key_here
AZURE_REGION=southeastasia

# Server Configuration
PORT=3000

# CORS Configuration (optional)
CORS_ORIGIN=http://localhost:5173
