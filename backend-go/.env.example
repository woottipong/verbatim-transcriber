# =============================================================================
# Thai Verbatim Transcriber - Backend Configuration
# =============================================================================
# 
# ตั้งค่าเฉพาะ provider ที่ต้องการใช้งาน endpoint จะถูกเปิดอัตโนมัติ
# ถ้าไม่ได้ใช้ provider ไหน ปล่อยว่างหรือ comment ไว้
#
# =============================================================================

# Gemini 2.0 Flash (API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Speech-to-Text (Service Account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./credential/stt-google.json

# Azure Speech Service (Subscription Key + Region)
AZURE_SUBSCRIPTION_KEY=your_azure_subscription_key_here
AZURE_REGION=southeastasia

# LiveKit Server (for real-time WebRTC streaming)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://localhost:7880

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
