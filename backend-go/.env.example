# =============================================================================
# Real-time Thai Transcription - Backend Configuration
# =============================================================================
# 
# NOTE: Each ASR provider endpoint will only be enabled if its API key is set.
# You can leave unused providers empty - those endpoints won't be available.
#
# Provider Status:
# - Deepgram: Direct browser connection (no backend needed)
# - Gemini: Backend relay (requires GEMINI_API_KEY)
# - Google Cloud STT: Backend relay (requires GOOGLE_API_KEY)
# - Azure Speech: Backend relay (requires AZURE keys)
#
# =============================================================================

# Deepgram API Configuration
# NOT USED - Deepgram connects directly from browser to wss://api.deepgram.com
# Set VITE_DEEPGRAM_API_KEY in frontend/.env instead
# DEEPGRAM_API_KEY=

# Gemini API Configuration  
# Required to enable /gemini endpoint
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Speech-to-Text API Configuration
# Required to enable /google endpoint
GOOGLE_API_KEY=your_google_api_key_here
# Or use Application Default Credentials (ADC) by setting:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Speech Service Configuration
# Required to enable /azure endpoint (both keys needed)
AZURE_SUBSCRIPTION_KEY=your_azure_subscription_key_here
AZURE_REGION=southeastasia

# Server Configuration
PORT=3000

# CORS Configuration (optional)
CORS_ORIGIN=http://localhost:5173
