# =============================================================================
# Thai Verbatim Transcriber - Backend Configuration
# =============================================================================
# 
# ตั้งค่าเฉพาะ provider ที่ต้องการใช้งาน endpoint จะถูกเปิดอัตโนมัติ
# ถ้าไม่ได้ใช้ provider ไหน ปล่อยว่างหรือ comment ไว้
#
# =============================================================================

# Google Cloud Speech-to-Text (Service Account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./credential/stt-google.json
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_SPEECH_MODEL=chirp_2

# Gemini Live source transcription (text only; translated audio is discarded)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-live-translate-preview
GEMINI_LANGUAGE_CODE=th
GEMINI_TARGET_LANGUAGE_CODE=en

# Azure Speech Service (Subscription Key + Region)
AZURE_SUBSCRIPTION_KEY=your_azure_subscription_key_here
AZURE_REGION=southeastasia

# LiveKit Server (for real-time WebRTC streaming)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://localhost:7880

# Server
PORT=3000
HOST=localhost

# CORS - Comma-separated list of allowed origins
# Default includes localhost and 127.0.0.1 for the frontend and backend dev ports.
# Production example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
