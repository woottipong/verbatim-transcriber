# Frontend Environment Variables

# Backend HTTP base URL
# Default: http://localhost:3000
VITE_BACKEND_URL=http://localhost:3000

# LiveKit Server URL
VITE_LIVEKIT_URL=ws://localhost:7880

# Must match backend CONTROL_API_KEY for trusted internal deployments.
# Do not embed this in a public frontend build.
VITE_CONTROL_API_KEY=

# For production/remote backend:
# VITE_BACKEND_URL=https://api.your-domain.com
# VITE_LIVEKIT_URL=wss://livekit.your-server.com
